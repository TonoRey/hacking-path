<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antonio.hacking-autopush</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/reycas/Documents/CloudeCowork/Hacking/push-to-github.sh</string>
    </array>

    <!-- Every Sunday at 8:30 PM CST -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/reycas/Documents/CloudeCowork/Hacking/autopush.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/reycas/Documents/CloudeCowork/Hacking/autopush.log</string>
</dict>
</plist>
